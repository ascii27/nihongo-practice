# Server
NODE_ENV=development
PORT=3001
PASSCODE=changeme
DATABASE_URL=postgres://nihongo:nihongo@localhost:5432/nihongo

# Optional: OpenAI key for listening TTS (unset ⇒ listening audio is a silent placeholder)
OPENAI_API_KEY=
# Where generated listening MP3s are written (served at /audio)
AUDIO_DIR=./data/audio

# Optional: send study-progress events to a Hermes (hermes-jester) inbox for Eva.
# Both must be set to enable; otherwise the sender is a no-op. The key needs the
# `write` scope. See server/src/services/hermes.ts.
HERMES_BASE_URL=https://lectern-queenside.exe.xyz
HERMES_WRITE_KEY=

# Client (Vite picks these up via import.meta.env)
VITE_API_BASE=http://localhost:3001
